# PostgreSQL connection. Local example below, or paste a Neon/Supabase URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/accounts_center?schema=public"

# Secrets used to sign JWTs. Use long random strings in real deployments.
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

# Access token lifetime (minutes) and refresh token lifetime (days).
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
